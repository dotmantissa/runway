# Node 22 or newer. All values are server-only.
PORT=3001
APP_ORIGIN=http://localhost:5174
# Production requires PostgreSQL. Development fallback needs a persistent disk.
# DATABASE_URL=postgresql://runway:runway@localhost:5432/runway
DATA_DIR=.data
TATUM_API_KEY=
TATUM_GRPC_URL=https://sui-mainnet-grpc.gateway.tatum.io
WALRUS_DELEGATE_KEY=
WALRUS_ACCOUNT_ID=
WALRUS_RELAYER_URL=https://relayer.memory.walrus.xyz
# Mainnet writes are opt-in and restricted to consenting personal workspaces.
MEMORY_WRITES_ENABLED=false
INLINE_WORKER=true
# Vercel uses scheduled processing plus waitUntil; set INLINE_WORKER=false.
JOB_MODE=inline
CRON_SECRET=
# Optional invoice intake agent. Use a separate, minimally funded tool wallet.
# Primary user wallet keys must never be supplied here. Server policy plus a
# small wallet balance bound exposure; this is not an onchain spending policy.
ENABLE_AGENT_PAYMENTS=false
TOOL_WALLET_KEY=
TOOL_ALLOWED_WALLETS=
TOOL_MAX_GAS_MIST=5000000
TOOL_DAILY_GAS_MIST=20000000
# Builder-operated structured-text/PDF service; exact native-USDC price 0.01.
PARSER_SERVICE_ENABLED=false
PARSER_SERVICE_URL=http://localhost:5174/api/v1/paid/invoice-parse
PARSER_RECIPIENT=
PARSER_PAYMENT_SECRET=
