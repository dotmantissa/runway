# Node 22 or newer. All values are server-only.
PORT=3001
APP_ORIGIN=http://localhost:5174
# Production requires PostgreSQL. Development fallback needs a persistent disk.
# DATABASE_URL=postgresql://runway:runway@localhost:5432/runway
DATA_DIR=.data
TATUM_API_KEY=
TATUM_GRPC_URL=https://sui-mainnet-grpc.gateway.tatum.io
WALRUS_DELEGATE_KEY=
WALRUS_ACCOUNT_ID=
WALRUS_RELAYER_URL=https://relayer.memory.walrus.xyz
# Mainnet writes are opt-in and restricted to consenting personal workspaces.
MEMORY_WRITES_ENABLED=false
INLINE_WORKER=true
# Vercel uses scheduled processing plus waitUntil; set INLINE_WORKER=false.
JOB_MODE=inline
CRON_SECRET=
