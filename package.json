{
  "name": "runway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx apps/server/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:all": "concurrently -k \"pnpm dev\" \"pnpm dev:web\"",
    "worker:dev": "tsx apps/server/src/worker.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts && tsup apps/server/src/server.ts apps/server/src/worker.ts apps/server/src/vercel.ts --format esm --out-dir dist/server --platform node --target node22 --splitting --external @mysten-incubation/memwal --external @electric-sql/pglite",
    "start": "node dist/server/server.js",
    "start:server": "node dist/server/server.js",
    "start:worker": "node dist/server/worker.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "smoke:memory": "tsx scripts/memory-smoke.ts",
    "memory:recover": "tsx scripts/memory-recover.ts",
    "smoke:tatum": "tsx scripts/tatum-smoke.ts",
    "smoke:postgres": "tsx scripts/postgres-smoke.ts",
    "evidence": "tsx scripts/evidence.ts",
    "copy:check": "tsx scripts/check-copy.ts",
    "evidence:corrections": "tsx scripts/memory-corrections.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "demo:record": "node scripts/record-demo.mjs",
    "demo:encode": "node scripts/encode-demo.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@fastify/cookie": "11.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "8.3.0",
    "@grpc/grpc-js": "1.14.6",
    "@mysten-incubation/memwal": "0.1.9",
    "@mysten/dapp-kit-core": "1.6.39",
    "@mysten/dapp-kit-react": "2.1.41",
    "@mysten/sui": "2.37.0",
    "@protobuf-ts/grpc-transport": "2.11.1",
    "@radix-ui/react-dialog": "1.1.15",
    "@suimpp/mpp": "0.9.0",
    "@tanstack/react-query": "5.90.5",
    "@vercel/functions": "3.10.3",
    "csv-parse": "6.1.0",
    "drizzle-orm": "0.44.7",
    "fastify": "5.6.1",
    "lucide-react": "0.468.0",
    "mppx": "0.4.12",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "7.65.0",
    "react-router-dom": "7.9.4",
    "unpdf": "1.9.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.10",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "9.2.1",
    "drizzle-kit": "0.31.6",
    "prettier": "3.6.2",
    "tsup": "8.5.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  }
}
